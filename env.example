# Environment Configuration for Program Loader Seed
# Copy this file to .env and update with your actual values
# NEVER commit .env to git - it contains secrets!

# ============================================================================
# ANALYTICS CONFIGURATION (REQUIRED)
# ============================================================================

# Google Tag Manager Container ID
# Get this from: https://tagmanager.google.com/
# Format: GTM-XXXXXXX
GTM_CONTAINER_ID=

# Google Tag Manager Test Container ID (optional, for local development)
# Leave empty to disable analytics in local dev
GTM_TEST_ID=

# Google Analytics 4 Measurement ID (optional, if using direct GA4)
# Get this from: https://analytics.google.com/
# Format: G-XXXXXXXXXX
GA4_MEASUREMENT_ID=

# ============================================================================
# SITE CONFIGURATION
# ============================================================================

# RYD Site Path (optional - for sandbox servers)
# Set this to the path where your RYD Site codebase is located
# Example: RYD_SITE_PATH=C:\Users\YourName\Documents\Site
# Example (Mac/Linux): RYD_SITE_PATH=/Users/YourName/Documents/Site
RYD_SITE_PATH=

# ============================================================================
# COMPLIANCE SETTINGS
# ============================================================================

# Enable/disable compliance checking (default: enabled)
COMPLIANCE_ENABLED=true

# Enable automatic fixes for compliance issues (default: disabled)
AUTO_FIX_ENABLED=false

# Strict mode for compliance (default: lenient)
COMPLIANCE_STRICT_MODE=false

# Auto-detect user region (default: enabled)
AUTO_DETECT_REGION=true

# ============================================================================
# LOGGING
# ============================================================================

# Logging Level (optional)
# Options: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# ============================================================================
# FIREBASE CONFIGURATION (optional)
# ============================================================================

# If using Firebase, set these or use firebase-config.json
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_SERVICE_ACCOUNT_PATH=path/to/service-account.json

# ============================================================================
# API KEYS (if needed)
# ============================================================================

# OpenAI API Key (if using AI features)
# OPENAI_API_KEY=

# Other API keys (add as needed)
# API_KEY_NAME=








