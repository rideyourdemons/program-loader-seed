# Environment variables for program-loader-seed
# Copy to .env and fill in your values

# Analytics (required for production)
# Get these from Google Tag Manager and GA4
GTM_CONTAINER_ID=GTM-XXXXXXX
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# Optional: test container for local dev (?analytics_debug=true to enable)
GTM_TEST_ID=GTM-XXXXXXX
