
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "exactOptionalPropertyTypes": true,
    "outDir": "./dist",
    "rootDir": "./"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "scripts/**/*"]
}

