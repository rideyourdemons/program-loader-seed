{
    "hosting": {
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": false,
      "trailingSlash": false,
      "rewrites": [
        { "source": "/app", "destination": "/app/index.html" },
        { "source": "/app/", "destination": "/app/index.html" }
      ]
    }
  }